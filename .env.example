# Long random string used to sign dashboard sessions.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# Supabase: Connect > Session pooler. Replace the password placeholder and
# use the exact host shown in your dashboard. API keys cannot replace this.
DATABASE_URI=

# Supabase's root CA from Database Settings > SSL Configuration. Paste the
# PEM certificate with escaped \n newlines. Certificate verification stays on.
DATABASE_SSL_CA=

# Optional direct/session connection for migrations when DATABASE_URI uses
# the transaction pooler (port 6543). Leave empty when using session mode.
DATABASE_MIGRATION_URI=

# Cloudinary > Settings > API Keys. Server only; never use NEXT_PUBLIC_ here.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Optional alternative to Cloudinary. Only used when CLOUDINARY_URL is empty.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for links in the dashboard.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Long random string used to sign dashboard sessions.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# Postgres connection string. Neon, Supabase and Vercel Postgres all have a
# free tier that is more than enough for this site.
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob token, used for image uploads in production.
# Vercel's filesystem is read-only, so uploads need blob storage there.
# Leave blank locally and uploads are written to ./media instead.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for links in the dashboard.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
